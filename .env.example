# Firebase (server-side only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY= # keep \n escapes; wrap in quotes

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL= # current Flash model name from Google AI docs

# Auth
JWT_SECRET= # 32+ random chars

# Email (Gmail SMTP with app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CareCircle <your@gmail.com>"

# Cron
CRON_SECRET= # random string, sent as x-cron-secret

# Reminder & Escalation Timing (optional, minutes)
# GRACE_MINUTES=30
# ESCALATION_MINUTES=30
# LOOKAHEAD_MINUTES=15

# App
APP_URL=https://your-app.vercel.app
DEFAULT_TIMEZONE=Asia/Kolkata
